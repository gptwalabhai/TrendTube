# TrendTube AI Production Environment Variables

# App Environment
NODE_ENV=production
PROJECT_NAME="TrendTube AI Engine"
SECRET_KEY="generate-a-secure-32-byte-secret-key-here"

# Database Configuration (Neon PostgreSQL Serverless)
DATABASE_URL="postgresql://user:password@ep-cool-cloud-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Redis Queue & Cache Configuration (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://cool-redis-12345.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AZ...="

# Frontend API URL
NEXT_PUBLIC_API_URL="https://api.trendtube.ai/api/v1"

# Primary AI Integration (Google Gemini 1.5 Flash API Key)
GEMINI_API_KEY="AIzaSy..."

# YouTube Data API OAuth Credentials
YOUTUBE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="your-google-oauth-client-secret"
YOUTUBE_REDIRECT_URI="https://trendtube.ai/api/auth/callback/youtube"

# Stripe Payments Keys
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
